{
    "name": "studioespresso/craft-dumper",
    "description": "Bringing symfony/VarDumper to Craft CMS",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "dumper"
    ],
    "support": {
        "docs": "https://github.com/studioespresso/craft-dumper/blob/develop/README.md",
        "issues": "https://github.com/studioespresso/craft-dumper/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Studio Espresso",
            "homepage": "https://www.studioespresso.co"
        }
    ],
    "require": {
        "php": ">=8.5",
        "craftcms/cms": "^6.0.0-beta.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0"
    },
    "scripts": {
        "check-cs": "pint --test",
        "fix-cs": "pint",
        "phpstan": "phpstan --memory-limit=1G",
        "ci": "pint && phpstan --memory-limit=1G"
    },
    "autoload": {
        "psr-4": {
            "studioespresso\\craftdumper\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "handle": "dumper",
        "name": "Dumper",
        "developer": "Studio Espresso",
        "documentationUrl": "https://github.com/studioespresso/craft-dumper",
        "class": "studioespresso\\craftdumper\\CraftDumper"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
